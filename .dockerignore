# Keep the image to the app: no local environments, history, logs or databases.
# (docker-compose.yml mounts the working folder over /app for development anyway.)

# Version control and tooling
.git
.gitignore
.claude
.vscode

# Python environments and caches
.venv
venv
env
**/__pycache__
**/*.py[cod]
.pytest_cache
.mypy_cache
.coverage
htmlcov

# Secrets
.env
.env.*

# Local data: the app creates its database from db/schema.sql and its log folder on start.
# (Unlike .gitignore, a pattern without **/ only matches at the top of the folder.)
**/*.db
**/*.db-wal
**/*.db-shm
**/*.sqlite3
logs
**/*.log

# Docker and Fly.io files themselves
Dockerfile
.dockerignore
docker-compose*.yml
fly.toml
